{
  "repo": "~/dev/projects/liferay-portal",
  "brand": {
    "title": "Claude Console",
    "icon": "~/.config/claude-console/icon.svg"
  },
  "devServer": {
    "process": "webpack"
  },
  "devEnv": {
    "files": [
      "workspaces/liferay-osbfaro-workspace/modules/osb-faro-web/.env",
      "modules/dxp/apps/osb/osb-faro/osb-faro-web/.env"
    ],
    "key": "FARO_URL",
    "rules": [
      {
        "match": "-stg.",
        "name": "STG"
      },
      {
        "match": "-internal.",
        "name": "INTERNAL"
      },
      {
        "match": "ldp.liferay.com",
        "name": "PROD"
      },
      {
        "match": "analytics.liferay.com",
        "name": "PROD"
      }
    ]
  },
  "jira": {
    "site": "https://liferay.atlassian.net"
  },
  "newSession": {
    "prompt": "/setup-faro-worktree {input} {env}",
    "inputLabel": "Ticket, name or pull request",
    "description": "Creates an osb-faro-web worktree (off upstream/master, or from the pull request's branch), optionally starts its webpack dev server against the chosen environment, and opens a Claude session in it that asks what the worktree is for.",
    "environments": [
      {
        "label": "STG",
        "value": "stg"
      },
      {
        "label": "INTERNAL",
        "value": "internal"
      },
      {
        "label": "PROD",
        "value": "prod"
      }
    ]
  },
  "briefing": {
    "model": "haiku",
    "language": "English",
    "maxBudgetUsd": 0.1
  },
  "reviewQueue": {
    "repo": "brianchandotcom/liferay-portal",
    "reviewer": "brianchandotcom",
    "name": "Brian",
    "mergedPattern": "^merged\\b",
    "branchSuffix": "-sender-{login}"
  }
}
