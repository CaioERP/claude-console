#!/usr/bin/env bash
# Usage: ghostty-tab <dir> [session-id [remote]]
#        ghostty-tab --new <dir> [prompt]
#
# Opens a new tab in the main Ghostty window and changes into <dir>. Given a
# session id, it resumes that Claude Code session there; with --new, it starts
# a new Claude Code session, sending [prompt] as its first message. With
# remote, the resumed session turns Remote Control on. The main
# window is the Ghostty window highest in the stacking order. Keystrokes are
# typed only after the new tab is confirmed to have the focus; otherwise nothing
# is typed. Without any Ghostty window, a new one opens in <dir> and runs the
# same command there.
#
# DRY_RUN=1 prints what it would do without touching any window.

set -uo pipefail

usage="usage: ghostty-tab <dir> [session-id [remote]] | ghostty-tab --new <dir> [prompt]"
is_new=false

if [ "${1:-}" = "--new" ]; then
	is_new=true
	shift
fi

dir="${1:?$usage}"
second="${2:-}"
third="${3:-}"

[ -d "$dir" ] || { echo "No such directory: $dir" >&2; exit 2; }

claude_command=""

if $is_new; then
	claude_command="claude"
	[ -n "$second" ] && claude_command="claude $(printf '%q' "$second")"
elif [ -n "$second" ]; then
	if ! [[ "$second" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
		echo "Not a session id: $second" >&2
		exit 2
	fi

	claude_command="claude --resume $second"

	if [ "$third" = "remote" ]; then
		claude_command="$claude_command --remote-control"
	elif [ -n "$third" ]; then
		echo "Not an option: $third" >&2
		exit 2
	fi
fi

quoted=$(printf '%q' "$dir")
command="cd $quoted"
[ -n "$claude_command" ] && command="$command && $claude_command"

notify() {
	command -v notify-send >/dev/null 2>&1 && notify-send "Claude console" "$1"
	echo "$1" >&2
}

# Ghostty windows from bottom to top of the stack; the last one is on top.
window=""
for id in $(xprop -root _NET_CLIENT_LIST_STACKING 2>/dev/null | grep -o '0x[0-9a-f]*'); do
	xprop -id "$id" WM_CLASS 2>/dev/null | grep -q 'com.mitchellh.ghostty' && window="$id"
done

# Without a Ghostty window there is no tab to type into, so a new window starts
# in <dir> and runs the Claude Code command, if any, in the person's interactive shell
# (for their PATH), falling back to that shell when Claude Code exits.
user_shell="${SHELL:-$(getent passwd "$(id -un)" | cut -d: -f7)}"
user_shell="${user_shell:-/bin/bash}"
launch=(ghostty --working-directory="$dir")
[ -n "$claude_command" ] && launch+=(-e "$user_shell" -ic "$claude_command; exec $(printf '%q' "$user_shell") -i")

if [ -n "${DRY_RUN:-}" ]; then
	if [ -n "$window" ]; then
		echo "window=$window command=$command"
	else
		echo "window=none launch=$(printf '%q ' "${launch[@]}")"
	fi
	exit 0
fi

if [ -z "$window" ]; then
	setsid "${launch[@]}" >/dev/null 2>&1 &
	exit 0
fi

wmctrl -i -a "$window"
xdotool windowactivate --sync "$window" 2>/dev/null
sleep 0.15
xdotool key --clearmodifiers ctrl+shift+t
sleep 0.35

active=$(xdotool getactivewindow 2>/dev/null)

if [ "$((active))" != "$((window))" ] || ! xprop -id "$active" WM_CLASS 2>/dev/null | grep -q 'com.mitchellh.ghostty'; then
	notify "Ghostty did not keep the focus, so nothing was typed. Run: $command"
	exit 1
fi

xdotool type --clearmodifiers --delay 2 -- "$command"
xdotool key --clearmodifiers Return
