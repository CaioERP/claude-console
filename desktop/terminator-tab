#!/usr/bin/env bash
# Usage: terminator-tab <dir> [session-id [remote]]
#        terminator-tab --new <dir> [prompt]
#
# Opens a new tab in the running Terminator window inside <dir>. Given a session
# id, it resumes that Claude Code session there, with Remote Control on when
# followed by remote; with --new, it starts a new Claude Code session, sending
# [prompt] as its first message. The tab keeps a
# shell open after Claude exits. Without a running Terminator, a new window
# opens.
#
# DRY_RUN=1 prints what it would do without touching any window.

set -uo pipefail

usage="usage: terminator-tab <dir> [session-id [remote]] | terminator-tab --new <dir> [prompt]"
is_new=false

if [ "${1:-}" = "--new" ]; then
	is_new=true
	shift
fi

dir="${1:?$usage}"
second="${2:-}"
third="${3:-}"

[ -d "$dir" ] || { echo "No such directory: $dir" >&2; exit 2; }

args=(--new-tab --working-directory="$dir")

# An interactive shell reads ~/.bashrc, so claude is on the PATH, and the tab
# stays open as a normal shell once the session ends. The session id or prompt
# reaches claude as an argument, never as shell code.
if $is_new; then
	if [ -n "$second" ]; then
		args+=(-x bash -ic 'claude "$1"; exec bash' bash "$second")
	else
		args+=(-x bash -ic 'claude; exec bash')
	fi
elif [ -n "$second" ]; then
	if ! [[ "$second" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
		echo "Not a session id: $second" >&2
		exit 2
	fi

	if [ "$third" = "remote" ]; then
		args+=(-x bash -ic 'claude --resume "$1" --remote-control; exec bash' bash "$second")
	elif [ -n "$third" ]; then
		echo "Not an option: $third" >&2
		exit 2
	else
		args+=(-x bash -ic 'claude --resume "$1"; exec bash' bash "$second")
	fi
fi

if [ -n "${DRY_RUN:-}" ]; then
	printf '%q ' terminator "${args[@]}"
	echo
	exit 0
fi

setsid terminator "${args[@]}" >/dev/null 2>&1 &
