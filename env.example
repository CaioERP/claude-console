# Secrets for Claude Console. install.sh copies this file to
# ~/.config/claude-console/env with mode 600; never commit the real one.
#
# Jira Cloud, used only when "jira" is set in config.json. Create a token at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_USER=
JIRA_API_TOKEN=
